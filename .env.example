# Copy this file to .env.local and fill in the values you want to use.
# Restart `npm run dev` (or rebuild / redeploy) after changing anything here.
# A channel with missing values is skipped; the form works as long as at least one channel succeeds.

# ---------- Where the enquiries go (change these any time) ----------
# Email address(es) that receive the form. Comma-separate for several. Default: hello@vortex5.com
CONTACT_EMAIL_TO=hello@vortex5.com
# WhatsApp number(s) that receive the form: digits only with country code, no "+". Default: number in lib/site.ts
CONTACT_WHATSAPP_TO=8801756688587

# ---------- 1. Telegram bot ----------
# Token from @BotFather. Chat id: your own id or a group id (start the bot first, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to read "chat":{"id":...}). Comma-separate for several chats.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- 2. WhatsApp ----------
# WhatsApp cannot be messaged automatically with a plain wa.me link, so pick one provider:
#   cloud     = Meta WhatsApp Business Cloud API (official; needs a Meta business account)
#   callmebot = CallMeBot (free, works with a personal number after one-time activation)
# Leave WHATSAPP_PROVIDER empty to turn WhatsApp off.
WHATSAPP_PROVIDER=

# If WHATSAPP_PROVIDER=cloud
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Free-form text only reaches a number that messaged your business number in the last 24 hours.
# To message anyone at any time, create an approved template with ONE body variable ({{1}}) and set:
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# If WHATSAPP_PROVIDER=callmebot (send "I allow callmebot to send me messages" to +34 644 51 95 23 on WhatsApp to get a key)
WHATSAPP_CALLMEBOT_APIKEY=

# ---------- 3. Email (SMTP) ----------
# Works with your hosting mailbox (cPanel), Google Workspace/Gmail (use an App Password), Zoho, etc.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (default is chosen from the port)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Optional. Example: Vortex5 Website <hello@vortex5.com>
SMTP_FROM=
